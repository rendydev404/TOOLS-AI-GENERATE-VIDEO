# Port aplikasi Rangkai
PORT=8787

# Batas request AI per IP per menit
RATE_LIMIT_PER_MIN=30

# ==========================================================
# KONFIGURASI AI GATEWAY: HERMES + 9ROUTER (VPS 3)
# ==========================================================
# Nama label gateway untuk tampilan status
AI_PROVIDER_NAME="Hermes · 9Router (VPS 3)"

# URL endpoint 9Router / Hermes di VPS 3 (otomatis dilengkapi /v1/chat/completions)
# Contoh: https://router.domainkamu.com/v1 atau http://IP_VPS_3:PORT/v1
AI_BASE_URL=

# API Key 9Router / Hermes
AI_API_KEY=

# Nama model combo dari 9Router (isi setelah dipilih)
AI_MODEL=

# Timeout per panggilan (ms) — 45000 aman untuk failover model combo di 9Router
AI_TIMEOUT_MS=45000
